# Copia este archivo como ".env" y completa los valores. El archivo ".env" NO se sube al repositorio.
# Estos valores son de ejemplo: no uses estas contrasenas en produccion.

# --- Base de datos ---
# Desarrollo local (docker compose up -d db)
DB_URL=jdbc:postgresql://localhost:5432/leviplus
DB_USER=leviplus
DB_PASSWORD=cambiar_en_local

# Produccion (Neon): copia la cadena de conexion desde el panel de Neon
# DB_URL=jdbc:postgresql://<host>/<base>?sslmode=require
# DB_USER=<usuario>
# DB_PASSWORD=<contrasena>

# --- Administrador inicial ---
# Si la tabla USUARIO esta vacia, la aplicacion crea este administrador al arrancar.
# Cambia la contrasena despues del primer ingreso.
LEVIPLUS_ADMIN_USER=admin
LEVIPLUS_ADMIN_PASSWORD=cambiar_la_primera_vez
LEVIPLUS_ADMIN_NOMBRE=Administrador

# --- Perfil de Spring ---
SPRING_PROFILES_ACTIVE=dev
